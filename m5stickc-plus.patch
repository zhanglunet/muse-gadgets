+#if CONFIG_HOMEHUB_LED_BACKEND_M5STICKC_PLUS_ST7789
+// M5StickC Plus (v1.x): the LCD backlight is AXP192 LDO2, enabled over I2C.
+// Mirrors M5GFX's Light_M5StickC: turn LDO2 on (register 0x12, bit 2) and set
+// its voltage to 3.3V (register 0x28, high nibble). Register 0x12 is
+// read-modify-written so the other rails keep whatever state they booted with.
+#define AXP192_I2C_ADDR  0x34
+#define AXP192_I2C_PORT  I2C_NUM_1
+#define AXP192_I2C_SDA   21
+#define AXP192_I2C_SCL   22
+static bool axp192_backlight_on(void) {
+    i2c_master_bus_config_t bus_cfg = {
+        .i2c_port = AXP192_I2C_PORT,
+        .sda_io_num = AXP192_I2C_SDA,
+        .scl_io_num = AXP192_I2C_SCL,
+        .clk_source = I2C_CLK_SRC_DEFAULT,
+        .glitch_ignore_cnt = 7,
+        .flags.enable_internal_pullup = true,
+    };
+    i2c_master_bus_handle_t bus = NULL;
+    i2c_master_dev_handle_t dev = NULL;
+    bool ok = i2c_new_master_bus(&bus_cfg, &bus) == ESP_OK;
+    if (ok) {
+        i2c_device_config_t dev_cfg = {
+            .dev_addr_length = I2C_ADDR_BIT_LEN_7,
+            .device_address = AXP192_I2C_ADDR,
+            .scl_speed_hz = 400000,
+        };
+        ok = i2c_master_bus_add_device(bus, &dev_cfg, &dev) == ESP_OK;
+    }
+    if (ok) {
+        uint8_t reg = 0;
+        uint8_t reg_addr = 0x12;
+        ok = i2c_master_transmit_receive(dev, &reg_addr, 1, &reg, 1, 100) == ESP_OK;
+        if (ok) {
+            uint8_t w[2] = {0x12, (uint8_t)(reg | (1 << 2))};
+            ok = i2c_master_transmit(dev, w, sizeof(w), 100) == ESP_OK;
+        }
+    }
+    if (ok) {
+        uint8_t w[2] = {0x28, 0xF0};
+        ok = i2c_master_transmit(dev, w, sizeof(w), 100) == ESP_OK;
+    }
+    if (dev) i2c_master_bus_rm_device(dev);
+    if (bus) i2c_del_master_bus(bus);
+    return ok;
+}
+#endif
