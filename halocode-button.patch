diff --git a/esp32/main/button.c b/esp32/main/button.c
index a4e01ed..496aad6 100644
--- a/esp32/main/button.c
+++ b/esp32/main/button.c
@@ -53,10 +53,18 @@ static void button_task(void *arg) {
     bool claimed = false;
 #endif
 
+    // Sample initial idle levels so both active-low and active-high buttons work
+    vTaskDelay(pdMS_TO_TICKS(100));
+    int idle_btn = gpio_get_level(BTN_GPIO);
+    int idle_0 = gpio_get_level(0);
+    ESP_LOGI(TAG, "button idle levels: GPIO %d=%d, GPIO 0=%d", BTN_GPIO, idle_btn, idle_0);
+
     while (1) {
-        bool pressed = (gpio_get_level(BTN_GPIO) == 0);
+        bool pressed = (gpio_get_level(BTN_GPIO) != idle_btn) || (gpio_get_level(0) != idle_0);
 
         if (pressed && !was_pressed) {
+            ESP_LOGI(TAG, "button down (GPIO %d=%d, GPIO 0=%d)",
+                     BTN_GPIO, gpio_get_level(BTN_GPIO), gpio_get_level(0));
             press_start = esp_timer_get_time();
             fired = false;
 #if CONFIG_HOMEHUB_VOICE
@@ -82,6 +90,7 @@ static void button_task(void *arg) {
             }
         } else if (!pressed && was_pressed && !fired) {
             int64_t held_ms = (esp_timer_get_time() - press_start) / 1000;
+            ESP_LOGI(TAG, "button up (held %lld ms)", held_ms);
             if (held_ms >= 50 && held_ms <= SHORT_PRESS_MAX_MS) {
                 click_count++;
                 last_release = esp_timer_get_time();
@@ -114,21 +123,34 @@ bool button_init(button_cb on_short_press, button_cb on_double_press,
     s_double_press_cb = on_double_press;
     s_long_press_cb = on_long_press;
 
+    // Configure primary button pin
     gpio_config_t cfg = {
         .pin_bit_mask = (1ULL << BTN_GPIO),
         .mode = GPIO_MODE_INPUT,
-        .pull_up_en = GPIO_PULLUP_ENABLE,
+        .pull_up_en = (BTN_GPIO < 34) ? GPIO_PULLUP_ENABLE : GPIO_PULLUP_DISABLE,
